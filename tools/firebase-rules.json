{
  "rules": {
    ".read": false,
    ".write": false,
    "r": {
      "$room": {
        ".read": true,
        ".write": true,
        ".validate": "$room.matches(/^[a-z0-9]{2,16}$/)",
        "h": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "x": {
          "$host": {
            "$link": {
              "o": { ".validate": "newData.val() === 1" },
              "u": { "$m": { ".validate": "newData.child('j').isString() && newData.child('j').val().length < 60000" } },
              "d": { "$m": { ".validate": "newData.child('j').isString() && newData.child('j').val().length < 60000" } },
              "$other": { ".validate": false }
            }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
